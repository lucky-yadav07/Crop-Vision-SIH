# Google Gemini API Key (Required for AI Vision Pathology & Pest Diagnostics)
GEMINI_API_KEY=

# Preferred Gemini Vision Model (Optional - defaults to gemini-2.5-flash with automatic cascade)
GEMINI_MODEL=gemini-2.5-flash

# OpenWeather API Key (Optional - free Open-Meteo fallback is automatically used if omitted)
OPENWEATHER_API_KEY=

# Port for the local server and cloud deployment (Default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development
